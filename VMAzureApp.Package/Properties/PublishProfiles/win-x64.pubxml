<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile used by the packaging project (VMAzureApp.Package.wapproj)
  when it publishes the app into the MSIX. Self-contained so the package
  includes the .NET 10 runtime and launches on a clean Windows machine
  without a separate runtime install.
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
