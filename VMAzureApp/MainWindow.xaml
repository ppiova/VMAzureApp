<Window x:Class="VMAzureApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cloud VM Manager" Height="650" Width="1100"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        Icon="Assets\AppIcon.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="Foreground" Value="#64748B" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="DashboardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DashboardValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Cloud VM Manager" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Manage virtual machines across subscriptions without opening the Azure portal."
                           Foreground="#64748B"
                           FontSize="14"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Sign in / Reload"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoadSubscriptionsCommand}" />
                <Button Content="Refresh VMs"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Subscription"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="#334155"
                           FontWeight="SemiBold" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Subscriptions}"
                          SelectedItem="{Binding SelectedSubscription}"
                          IsEnabled="{Binding IsIdle}"
                          DisplayMemberPath="Name"
                          MinWidth="320"
                          Padding="10,6"
                          BorderBrush="#CBD5E1" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Foreground="#64748B" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL VMS" Style="{StaticResource DashboardLabelStyle}" />
                    <TextBlock Text="{Binding TotalVmCount}" Style="{StaticResource DashboardValueStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="RUNNING" Style="{StaticResource DashboardLabelStyle}" />
                    <TextBlock Text="{Binding RunningVmCount}" Style="{StaticResource DashboardValueStyle}" Foreground="#16A34A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="STOPPED" Style="{StaticResource DashboardLabelStyle}" />
                    <TextBlock Text="{Binding StoppedVmCount}" Style="{StaticResource DashboardValueStyle}" Foreground="#DC2626" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" />
                        <TextBlock Text="Search by name, group, region, size or status..."
                                   Foreground="#94A3B8"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Margin="0,0,10,0"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Start selected"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StartSelectedCommand}" />
                        <Button Content="Stop selected"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StopSelectedCommand}" />
                        <Button Content="Refresh status"
                                Margin="0,0,12,0"
                                Padding="10,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshStatusesCommand}" />
                        <CheckBox Content="Auto"
                                  VerticalAlignment="Center"
                                  ToolTip="Automatically refresh power states every 45 seconds"
                                  IsChecked="{Binding AutoRefreshStatuses}" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="VmDataGrid"
                          ItemsSource="{Binding VirtualMachinesView}"
                          SelectedItem="{Binding SelectedVirtualMachine}"
                          SelectionMode="Extended"
                          SelectionChanged="OnVmSelectionChanged"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderThickness="0"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="White"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="Transparent">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#475569" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="#0F172A" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="VM" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Resource group" Binding="{Binding ResourceGroupName}" Width="2*" />
                        <DataGridTextColumn Header="Region" Binding="{Binding Location}" Width="*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="1.5*" />
                        <DataGridTemplateColumn Header="Actions" Width="330">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Start"
                                                Margin="0,0,6,0"
                                                Padding="10,5"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanStart}"
                                                Command="{Binding DataContext.StartVmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Stop"
                                                Margin="0,0,6,0"
                                                Padding="10,5"
                                                Style="{StaticResource DangerButtonStyle}"
                                                IsEnabled="{Binding CanStop}"
                                                Command="{Binding DataContext.StopVmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Restart"
                                                Margin="0,0,6,0"
                                                Padding="10,5"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding CanRestart}"
                                                Command="{Binding DataContext.RestartVmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Hibernate"
                                                Padding="10,5"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding CanHibernate}"
                                                Visibility="{Binding SupportsHibernation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.HibernateVmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="VM DETAILS" Style="{StaticResource DashboardLabelStyle}" />
                            <TextBlock Text="{Binding SelectedVirtualMachine.Name}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subscription" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedVirtualMachine.SubscriptionName}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Resource group" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVirtualMachine.ResourceGroupName}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Region" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedVirtualMachine.Location}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Size" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedVirtualMachine.Size}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="OS" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVirtualMachine.OsType}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Computer" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVirtualMachine.ComputerName}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Disks" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedVirtualMachine.DiskSummary}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Zones" Foreground="#64748B" Margin="0,0,8,8" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedVirtualMachine.Zones}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Tags" Foreground="#64748B" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedVirtualMachine.Tags}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ADD SCHEDULE" Style="{StaticResource DashboardLabelStyle}" />
                            <TextBlock Text="Schedules run in local time while the app is open or running in the tray."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding ScheduleActions}"
                                          SelectedItem="{Binding NewScheduleAction}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,8,8"
                                          Padding="8,5" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewScheduleTime, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"
                                         Padding="8,5" />
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <CheckBox Content="Mon" IsChecked="{Binding NewScheduleMonday}" />
                                <CheckBox Content="Tue" IsChecked="{Binding NewScheduleTuesday}" />
                                <CheckBox Content="Wed" IsChecked="{Binding NewScheduleWednesday}" />
                                <CheckBox Content="Thu" IsChecked="{Binding NewScheduleThursday}" />
                                <CheckBox Content="Fri" IsChecked="{Binding NewScheduleFriday}" />
                                <CheckBox Content="Sat" IsChecked="{Binding NewScheduleSaturday}" />
                                <CheckBox Content="Sun" IsChecked="{Binding NewScheduleSunday}" />
                            </UniformGrid>

                            <Button Content="Add schedule for selected VM"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddScheduleCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="SCHEDULES" Style="{StaticResource DashboardLabelStyle}" />
                            <ItemsControl ItemsSource="{Binding Schedules}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left"
                                                              IsChecked="{Binding Enabled}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding LastResult}" Foreground="#64748B" TextWrapping="Wrap" Margin="24,4,0,6" />
                                                <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                                    <Button Content="Run now"
                                                            Padding="8,4"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.RunScheduleNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Delete"
                                                            Padding="8,4"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#991B1B" />
        </Border>

    </Grid>
</Window>
